---
import { TAGS } from "../constants/Tags.js";
import Tag from "./Tag.astro";

const LANGUAGE_SKILLS = [TAGS.PYTHON, TAGS.BASH, TAGS.GO, TAGS.CPP];
const CLOUD_SKILLS = [TAGS.AWS, TAGS.DIGITALOCEAN, TAGS.KUBERNETES, TAGS.DOCKER, TAGS.ISTIO, TAGS.CLOUDFLARE];
const AUTOMATION_SKILLS = [TAGS.HELM, TAGS.TERRAFORM];
const CICD_SKILLS = [TAGS.GITLAB, TAGS.JENKINS];
const LM_SKILLS = [TAGS.PROMETHEUS, TAGS.GRAFANA, TAGS.PAGERDUTY, TAGS.DATADOG, TAGS.SUMOLOGIC];
const SOFT_SKILLS = [
  TAGS.FLEXIBILITY,
  TAGS.TEAMWORK,
  TAGS.INITIATIVE,
  TAGS.CRITIC,
  TAGS.PROBLEMRES,
  TAGS.LEARN,
];
const TOOLS_SKILLS = [
  TAGS.LINUX,
  TAGS.GIT,
  TAGS.GITHUB,
  TAGS.SLACK,
];
---

<div class="text-white">
  <h4 class="text-xl font-semibold my-2 pt-6">Languages</h4>
  <ul class="flex gap-x-4 flex-row flex-wrap">
    {
      LANGUAGE_SKILLS.map((skill) => (
        <Tag name={skill.name}>
          <skill.icon class="size-5 text-white" />
        </Tag>
      ))
    }
  </ul>
  <h4 class="text-xl font-semibold my-2 pt-6">Cloud Tech</h4>
  <ul class="flex gap-x-4 flex-row flex-wrap">
    {
      CLOUD_SKILLS.map((skill) => (
        <Tag name={skill.name}>
          <skill.icon class="size-5 text-white" />
        </Tag>
      ))
    }
  </ul>
  <h4 class="text-xl font-semibold my-2 pt-6">Automations</h4>
  <ul class="flex gap-x-4 flex-row flex-wrap">
    {
      AUTOMATION_SKILLS.map((skill) => (
        <Tag name={skill.name}>
          <skill.icon class="size-5 text-white" />
        </Tag>
      ))
    }
  </ul>
  <h4 class="text-xl font-semibold my-2 pt-6">CI | CD</h4>
  <ul class="flex gap-x-4 flex-row flex-wrap">
    {
      CICD_SKILLS.map((skill) => (
        <Tag name={skill.name}>
          <skill.icon class="size-5 text-white" />
        </Tag>
      ))
    }
  </ul>
  <h4 class="text-xl font-semibold my-2 pt-6">Logging and Monitoring</h4>
  <ul class="flex gap-x-4 flex-row flex-wrap">
    {
      LM_SKILLS.map((skill) => (
        <Tag name={skill.name}>
          <skill.icon class="size-5 text-white" />
        </Tag>
      ))
    }
  </ul>
  <h4 class="text-xl font-semibold my-2 pt-6">Soft Skills</h4>
  <ul class="flex gap-x-4 flex-row flex-wrap">
    {
      SOFT_SKILLS.map((skill) => (
        <Tag name={skill.name}>
          <skill.icon class="size-5" />
        </Tag>
      ))
    }
  </ul>
  <h4 class="text-xl font-semibold my-2 pt-6">Tools & Systems</h4>
  <ul class="flex gap-x-4 flex-row flex-wrap">
    {
      TOOLS_SKILLS.map((skill) => (
        <Tag name={skill.name}>
          <skill.icon class="size-5 text-white" />
        </Tag>
      ))
    }
  </ul>
</div>
