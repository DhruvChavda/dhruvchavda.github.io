---
import { TAGS } from "../constants/Tags.js";
import Tag from "./Tag.astro";

const LANGUAGE_SKILLS = [TAGS.PYTHON, TAGS.BASH, TAGS.GO, TAGS.CPP];
const CLOUD_SKILLS = [TAGS.AWS, TAGS.DIGITALOCEAN, TAGS.KUBERNETES, TAGS.DOCKER, TAGS.ISTIO, TAGS.CLOUDFLARE];
const AUTOMATION_SKILLS = [TAGS.HELM, TAGS.TERRAFORM, TAGS.CLOUDFORMATION];
const CICD_SKILLS = [TAGS.GITLAB, TAGS.JENKINS, TAGS.GITLEAKS];
const LM_SKILLS = [TAGS.PROMETHEUS, TAGS.ALERTMANAGER, TAGS.GRAFANA, TAGS.PAGERDUTY, TAGS.DATADOG, TAGS.SUMOLOGIC, TAGS.LOKI];
const SOFT_SKILLS = [
  TAGS.FLEXIBILITY,
  TAGS.TEAMWORK,
  TAGS.INITIATIVE,
  TAGS.CRITIC,
  TAGS.PROBLEMRES,
  TAGS.LEARN,
];
const TOOLS_SKILLS = [
  TAGS.LINUX,
  TAGS.GIT,
  TAGS.GITHUB,
  TAGS.SLACK,
  TAGS.JIRA,
  TAGS.WORDPRESS,
  TAGS.AIRFLOW,
  TAGS.INFISICAL,
  TAGS.ENTRA,
];

const SKILL_GROUPS = [
  { title: "Languages", skills: LANGUAGE_SKILLS },
  { title: "Cloud Tech", skills: CLOUD_SKILLS },
  { title: "Automations", skills: AUTOMATION_SKILLS },
  { title: "CI | CD", skills: CICD_SKILLS },
  { title: "Logging and Monitoring", skills: LM_SKILLS },
  { title: "Soft Skills", skills: SOFT_SKILLS },
  { title: "Tools & Systems", skills: TOOLS_SKILLS },
];
---

<div class="text-white">
  {
    SKILL_GROUPS.map((group) => (
      <>
        <h3 class="text-xl font-semibold my-2 pt-6">{group.title}</h3>
        <ul class="flex gap-x-4 flex-row flex-wrap">
          {group.skills.map((skill) => (
            <Tag name={skill.name}>
              {skill.iconUrl ? (
                <img src={skill.iconUrl} alt={skill.name} width="20" height="20" class="size-5" loading="lazy" />
              ) : skill.icon ? (
                <skill.icon class="size-5" />
              ) : null}
            </Tag>
          ))}
        </ul>
      </>
    ))
  }
</div>
