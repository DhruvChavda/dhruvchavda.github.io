---
import LinkedIn from "../icons/LinkedIn.astro";
import GitHub from "../icons/GitHub.astro";
import Instagram from "../icons/Instagram.astro";
import X from "../icons/X.astro";
import Behance from "../icons/behance.astro";
import Topmate from "../icons/Topmate.astro";
---

<nav
  class="container mx-auto lg:w-[740px] flex flex-col lg:flex-row justify-center items-center justify-between p-5"
>
  <div class="flex items-center space-x-4 md:space-x-4">
    <a
      aria-label="Visit my GitHub profile"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full text-white flex justify-center items-center gap-x-2 hover:scale-110 hover transition"
      href="https://github.com/DhruvChavda"
    >
      <GitHub class="size-4 lg:size-6" />
    </a>
    <p>|</p>
    <a
      aria-label="Visit my LinkedIn profile"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full text-white flex justify-center items-center gap-x-2 hover:scale-110 hover transition"
      href="https://www.linkedin.com/in/dhruvchavda2712/"
    >
      <LinkedIn class="size-4 lg:size-6" />
    </a>
    <p>|</p>
    <a
      aria-label="Visit my Instagram profile"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full text-white flex justify-center items-center gap-x-2 hover:scale-110 hover transition"
      href="https://www.instagram.com/d.m.c_2712"
    >
      <Instagram class="size-4 lg:size-6" />
    </a>
    <p>|</p>
    <a
      aria-label="Follow me on X (formerly Twitter)"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full text-white flex justify-center items-center gap-x-2 hover:scale-110 hover transition"
      href="https://x.com/dmc_2712"
    >
      <X class="size-4 lg:size-6" />
    </a>
    <p>|</p>
    <a
      aria-label="Visit my Behance portfolio"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full text-white flex justify-center items-center gap-x-2 hover:scale-110 hover transition"
      href="https://www.behance.net/dhruvchavda2712"
    >
      <Behance class="size-4 lg:size-6" />
    </a>
    <p>|</p>
    <a
      aria-label="Book a consultation on Topmate"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full text-white flex justify-center items-center gap-x-2 hover:scale-110 hover transition"
      href="https://topmate.io/dhruvchavda/"
    >
      <Topmate class="size-4 lg:size-6" />
    </a>
  </div>
</nav>
