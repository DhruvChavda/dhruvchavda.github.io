---
interface Props {
  name: string;
  href: string;
  active?: boolean;
}

const { name, href, active = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center rounded-full text-sm py-1 px-3 transition-all duration-300 hover:scale-105",
    active
      ? "bg-yellow-500/20 text-yellow-200 border border-yellow-500/30"
      : "bg-white/5 text-white/60 border border-white/10 hover:bg-yellow-500/10 hover:text-yellow-200 hover:border-yellow-500/20",
  ]}
>
  {name}
</a>
