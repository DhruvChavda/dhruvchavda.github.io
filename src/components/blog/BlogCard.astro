---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: string;
  category: string;
  tags: string[];
  slug: string;
  readingTime: string;
}

const { title, description, pubDate, heroImage, category, tags, slug, readingTime } =
  Astro.props;
---

<article
  class="group break-inside-avoid mb-3"
  data-blog-card
  data-title={title.toLowerCase()}
  data-category={category.toLowerCase()}
  data-tags={tags.join(",").toLowerCase()}
  data-description={description.toLowerCase()}
>
  <a
    href={`/blogs/${slug}/`}
    class="block overflow-hidden bg-white/[0.03] border border-white/[0.06] hover:border-purple-400/30 hover:bg-white/[0.07] transition-all duration-300"
  >
    {
      heroImage && (
        <img
          src={heroImage}
          alt={title}
          class="w-full object-cover"
          loading="lazy"
        />
      )
    }
    <div class="p-4">
      <div class="flex items-center gap-2 mb-2">
        <span
          class="text-[10px] uppercase tracking-wider text-yellow-200/80 bg-yellow-500/10 px-2 py-0.5 font-medium"
        >
          {category}
        </span>
        <span class="text-[10px] text-gray-500">{readingTime}</span>
        <span class="text-[10px] text-gray-500 flex items-center gap-0.5 view-count" data-path={`/blogs/${slug}/`}>
          <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <span class="count-value">—</span>
        </span>
      </div>
      <h3
        class="text-[15px] font-semibold text-white/90 group-hover:text-yellow-200 transition-colors leading-tight"
      >
        {title}
      </h3>
      <p class="text-white/40 mt-1.5 text-xs leading-relaxed line-clamp-2">
        {description}
      </p>
      <time class="text-[10px] text-gray-600 mt-2 block">
        {
          pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </time>
    </div>
  </a>
</article>
