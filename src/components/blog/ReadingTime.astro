---
interface Props {
  minutesRead: string;
}

const { minutesRead } = Astro.props;
---

<span class="text-gray-400 text-sm flex items-center gap-1">
  <svg
    class="size-4"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <polyline points="12 6 12 12 16 14"></polyline>
  </svg>
  {minutesRead}
</span>
