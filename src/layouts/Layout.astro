---
import "@fontsource-variable/onest";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ParticleBackground from "../components/ParticleBackground.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  keywords?: string;
  ogType?: string;
  pubDate?: Date;
  updatedDate?: Date;
}

const { title, description, ogImage = "/og-image.png", keywords, ogType = "website", pubDate, updatedDate } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Dhruv Chavda" />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
    
    <!-- Performance Optimizations - Critical Font Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    
    <!-- Preload critical image with high priority (only on home page) -->
    {Astro.url.pathname === "/" && <link rel="preload" href="/pictures/potrait.webp" as="image" type="image/webp" fetchpriority="high" />}
    
    <!-- Resource Hints -->
    <link rel="prefetch" href="/rss.xml" />
    
    <!-- GoatCounter (view counts) — Change YOUR_CODE to your goatcounter.com site code -->
    <script
      data-goatcounter="https://dhruvchavda.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"
    ></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-B6GWYJ1HHM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-B6GWYJ1HHM');
    </script>
    
    <!-- Defer non-critical CSS to reduce render-blocking -->
    <style>
      /* Critical inline styles for above-the-fold content - fast font fallback */
      html {
        font-family: "Onest Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        scroll-behavior: smooth;
        color-scheme: light dark;
      }
      body {
        background: #050505;
        margin: 0;
        padding: 0;
      }
      /* Use font-display: swap to prevent font blocking */
      @font-face {
        font-family: "Onest Variable";
        font-display: swap;
      }
    </style>
    
    <title>{title}</title>
  </head>
  <body>
    <ParticleBackground />
    <Header />
    <slot />
    <Footer />
    <script>
      // Scroll Reveal Observer (global — works on all pages)
      const scrollElements = document.querySelectorAll('[data-scroll], [data-scroll-left]');
      const scrollObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              scrollObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.02, rootMargin: '0px 0px 50px 0px' }
      );
      scrollElements.forEach((el) => scrollObserver.observe(el));

      // Fetch view counts from GoatCounter (skips localhost — CORS blocked in dev)
      const GOATCOUNTER_SITE = "dhruvchavda";
      const isLocalhost = location.hostname === "localhost" || location.hostname === "127.0.0.1";
      if (!isLocalhost) {
        const viewCountEls = document.querySelectorAll(".view-count");
        viewCountEls.forEach(async (el) => {
          const path = (el as HTMLElement).dataset.path;
          if (!path) return;
          try {
            const res = await fetch(
              `https://${GOATCOUNTER_SITE}.goatcounter.com/counter/${encodeURIComponent(path)}.json`
            );
            if (res.ok) {
              const data = await res.json();
              const countEl = el.querySelector(".count-value");
              if (countEl) countEl.textContent = `${data.count} views`;
            }
          } catch {
            // Silently fail — count stays as "—"
          }
        });
      }
    </script>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light dark;
  }
  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }
  body {
    display: flex;
    flex-direction: column;
    background: #050505;
    height: 100vh;
  }

  /* Scroll reveal animations */
  [data-scroll] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }
  [data-scroll].visible {
    opacity: 1;
    transform: translateY(0);
  }
  [data-scroll-left] {
    opacity: 0;
    transform: translateX(-15px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }
  [data-scroll-left].visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Typing cursor */
  #typed-text::after {
    content: '|';
    animation: blink 1s step-end infinite;
    color: rgba(120, 119, 198, 0.8);
    font-weight: 300;
    margin-left: 2px;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Timeline dot pulse */
  @keyframes dot-pulse {
    0% { box-shadow: 0 0 0 0 rgba(120, 119, 198, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(120, 119, 198, 0); }
    100% { box-shadow: 0 0 0 0 rgba(120, 119, 198, 0); }
  }
  .dot-pulse {
    animation: dot-pulse 1.5s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    [data-scroll], [data-scroll-left] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    #typed-text::after {
      animation: none;
    }
  }
</style>
