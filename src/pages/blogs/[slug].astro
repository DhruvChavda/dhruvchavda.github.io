---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import TableOfContents from "../../components/blog/TableOfContents.astro";
import ReadingTime from "../../components/blog/ReadingTime.astro";
import BlogTagBadge from "../../components/blog/BlogTagBadge.astro";
import { getReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body || "");
---

<Layout
  title={`${post.data.title} | Dhruv Chavda`}
  description={post.data.description}
  ogImage={post.data.heroImage}
  ogType="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
>
  <main class="px-2">
    <SectionContainer id="blog-post" class="pt-24" noReveal>
      <!-- Back link -->
      <a
        href="/blogs/"
        class="text-white/50 hover:text-yellow-200 transition-colors text-sm mb-8 inline-flex items-center gap-1"
      >
        <svg
          class="size-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        All posts
      </a>

      <!-- Post header -->
      <header class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          {post.data.category.map((cat) => (
            <a
              href={`/blogs/category/${cat.toLowerCase()}/`}
              class="text-xs bg-yellow-500/10 text-yellow-200 px-3 py-1 rounded-full border border-yellow-500/20 hover:bg-yellow-500/20 transition-colors"
            >
              {cat}
            </a>
          ))}
          <ReadingTime minutesRead={readingTime} />
          <span class="text-gray-400 text-sm flex items-center gap-1 view-count" data-path={`/blogs/${post.id}/`}>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <span class="count-value">—</span>
          </span>
        </div>
        <h1
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight"
        >
          {post.data.title}
        </h1>
        <p class="text-white/60 text-lg mb-4">{post.data.description}</p>
        <div class="flex items-center gap-4 text-sm text-gray-500">
          <time datetime={post.data.pubDate.toISOString()}>
            {
              post.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
          {
            post.data.updatedDate && (
              <span>
                Updated:{" "}
                {post.data.updatedDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
            )
          }
        </div>
      </header>

      <!-- Hero image -->
      {
        post.data.heroImage && (
          <img
            src={post.data.heroImage}
            alt={post.data.heroImageAlt}
            class="w-full rounded-lg mb-8 max-h-96 object-cover"
          />
        )
      }

      <!-- Table of Contents -->
      <TableOfContents headings={headings} />

      <!-- Blog content -->
      <article
        class="prose prose-invert max-w-none
        prose-headings:text-white prose-headings:font-semibold
        prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
        prose-a:text-yellow-200 prose-a:no-underline hover:prose-a:underline
        prose-code:before:content-none prose-code:after:content-none
        prose-pre:bg-[#1a1a2e] prose-pre:border prose-pre:border-white/10 prose-pre:rounded-lg
        [&_:not(pre)>code]:text-green-300 [&_:not(pre)>code]:bg-white/10 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded [&_:not(pre)>code]:text-sm
        prose-blockquote:border-l-yellow-500 prose-blockquote:text-white/70
        prose-strong:text-white
        prose-img:rounded-lg
        prose-li:text-white/80
        prose-p:text-white/80
        prose-ol:text-white/80
        prose-ul:text-white/80"
      >
        <Content />
      </article>

      <!-- Tags -->
      {
        post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-10 pt-8 border-t border-white/10">
            {post.data.tags.map((tag) => (
              <BlogTagBadge
                name={`#${tag}`}
                href={`/blogs/tag/${tag.toLowerCase()}/`}
              />
            ))}
          </div>
        )
      }
    </SectionContainer>
  </main>
</Layout>

<style is:global>
  .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.3);
    padding: 6px;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .copy-btn:hover {
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.08);
  }
  .copy-btn.copied {
    color: #86efac;
  }
  .prose pre {
    position: relative;
    padding-top: 2.5rem;
  }
  .prose pre code {
    counter-reset: line;
  }
  .prose pre code > .line::before {
    counter-increment: line;
    content: counter(line);
    min-width: 3ch;
    margin-right: 1rem;
    display: inline-block;
    text-align: right;
    color: rgba(255, 255, 255, 0.2);
    user-select: none;
  }
  .prose pre .lang-label {
    position: absolute;
    top: 8px;
    left: 12px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.25);
    font-family: system-ui, sans-serif;
    pointer-events: none;
  }
</style>

<script>
  document.querySelectorAll(".prose pre").forEach((pre) => {
    // Language label (Shiki puts data-language on <pre>)
    const lang = pre.getAttribute("data-language");
    if (lang) {
      const label = document.createElement("span");
      label.className = "lang-label";
      label.textContent = lang;
      pre.appendChild(label);
    }

    // Copy button
    const btn = document.createElement("button");
    btn.className = "copy-btn";
    btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
    btn.addEventListener("click", async () => {
      const code = pre.querySelector("code");
      const text = code ? code.textContent || "" : pre.textContent || "";
      await navigator.clipboard.writeText(text);
      btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
      btn.classList.add("copied");
      setTimeout(() => {
        btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
        btn.classList.remove("copied");
      }, 2000);
    });
    pre.appendChild(btn);
  });
</script>
