---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import BlogTagBadge from "../../components/blog/BlogTagBadge.astro";
import { getReadingTime } from "../../utils/readingTime";

const allPosts = (
  await getCollection("blog", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  })
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(allPosts.map((post) => post.data.category))];
---

<Layout
  title="Blogs | Dhruv Chavda"
  description="Thoughts on DevOps, Kubernetes, platform engineering, and cloud-native technologies by Dhruv Chavda."
>
  <main class="px-2">
    <SectionContainer id="blog-listing" class="pt-24">
      <a
        href="/"
        class="text-white/50 hover:text-yellow-200 transition-colors text-sm mb-8 inline-flex items-center gap-1"
      >
        <svg
          class="size-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Back to Portfolio
      </a>

      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Blogs</h1>
      <p class="text-white/60 mb-6 text-lg">
        Thoughts on DevOps, Kubernetes, and platform engineering.
      </p>

      <!-- Search -->
      <div class="relative mb-5">
        <svg
          class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-gray-500 pointer-events-none"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          id="blog-search"
          type="text"
          placeholder="Search posts..."
          class="w-full bg-white/[0.03] border border-white/[0.08] text-white text-sm pl-10 pr-4 py-2.5 focus:outline-none focus:border-purple-400/40 transition-colors placeholder:text-gray-600"
        />
      </div>

      <!-- Category filters -->
      {
        categories.length > 1 && (
          <div class="flex flex-wrap gap-2 mb-6">
            <BlogTagBadge name="All" href="/blogs/" active={true} />
            {categories.map((cat) => (
              <BlogTagBadge
                name={cat}
                href={`/blogs/category/${cat.toLowerCase()}/`}
              />
            ))}
          </div>
        )
      }

      <!-- Masonry post grid -->
      {
        allPosts.length > 0 ? (
          <div id="blog-grid" class="columns-1 sm:columns-2 gap-3">
            {allPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                heroImage={post.data.heroImage}
                category={post.data.category}
                tags={post.data.tags}
                slug={post.id}
                readingTime={getReadingTime(post.body || "")}
              />
            ))}
          </div>
        ) : (
          <p class="text-white/40 text-center py-12">
            No posts yet. Check back soon!
          </p>
        )
      }

      <p id="no-results" class="text-white/40 text-center py-12 hidden">
        No posts match your search.
      </p>
    </SectionContainer>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById("blog-search") as HTMLInputElement;
  const cards = document.querySelectorAll("[data-blog-card]");
  const noResults = document.getElementById("no-results");

  if (searchInput) {
    searchInput.addEventListener("input", () => {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const title = el.dataset.title || "";
        const category = el.dataset.category || "";
        const tags = el.dataset.tags || "";
        const description = el.dataset.description || "";

        const matches =
          !query ||
          title.includes(query) ||
          category.includes(query) ||
          tags.includes(query) ||
          description.includes(query);

        el.style.display = matches ? "" : "none";
        if (matches) visibleCount++;
      });

      if (noResults) {
        noResults.classList.toggle("hidden", visibleCount > 0);
      }
    });
  }
</script>
