---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 - Page Not Found | Dhruv Chavda"
  description="Sorry, the page you're looking for doesn't exist. Visit Dhruv Chavda's portfolio."
>
  <main class="px-2">
    <div class="flex flex-col items-center justify-center min-h-screen gap-6">
      <h1 class="text-6xl font-bold text-white">404</h1>
      <h2 class="text-2xl font-semibold text-yellow-200">Page Not Found</h2>
      <p class="text-white text-center max-w-md">
        Sorry, the page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="rounded-full text-white border border-white/10 flex justify-center items-center gap-x-2 py-2 px-4 text-base bg-white/5 hover:scale-110 hover:bg-white/10 transition"
      >
        Go back home
      </a>
    </div>
  </main>
</Layout>
