---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import GitHub from "../icons/GitHub.astro";
import Mail from "../icons/Mail.astro";
import SocialPill from "../components/SocialPill.astro";
import Experience from "../components/Experience.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Briefcase from "../icons/Briefcase.astro";
import Code from "../icons/Code.astro";
import Skills from "../components/Skills.astro";
import Medium from "../icons/Medium.astro";
import Credly from "../icons/Credly.astro";
import Team from "../icons/Team.astro";
import Socials from "../components/Socials.astro";
import Learn from "../icons/Learn.astro";
import About from "../components/About.astro";
import Highlight from "../components/Highlight.astro";
import Schema from "../components/Schema.astro";
import Topmate from "../icons/Topmate.astro";

const title = "Dhruv Chavda | DevOps Engineer & CKA Certified Professional";
const description = "DevOps/SRE Engineer with 3+ years of experience in Kubernetes, Docker, AWS, and cloud infrastructure. CKA certified specialist in Istio, K8s Operators, and cost optimization.";
const keywords = "DevOps, Kubernetes, Docker, AWS, Terraform, CI/CD, SRE, Cloud Engineer, Istio, Infrastructure";
const socialProfiles = [
  "https://www.linkedin.com/in/dhruvchavda2712/",
  "https://github.com/DhruvChavda",
  "https://medium.com/@chavdadhruv0505",
  "https://www.credly.com/users/dhruvchavda",
];

---

<Layout
	title={title}
	description={description}
	keywords={keywords}
	ogImage="/pictures/potrait.webp"
>
	<Schema
		name="Dhruv Chavda"
		title="DevOps Engineer"
		description={description}
		image="https://dhruvchavda.in/pictures/potrait.webp"
		url="https://dhruvchavda.in"
		email="chavdadhruv0505@gmail.com"
		location="Pune"
		socialProfiles={socialProfiles}
	/>
	<main class="px-2">
		<SectionContainer id="top" class="py-36 pb-36">
			<img
				class="rounded-full size-40 mb-8"
				src="/pictures/potrait.webp"
				alt="Dhruv Chavda photo"
			/>
			<h1
				class="text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-4 pb-6 lg:pb-10"
			>
			 👋 Hello! I'm Dhruv
				<a
					href="https://www.linkedin.com/in/dhruvchavda2712/"
					target="_blank"
					rel="noopener"
					class="flex justify-center items-center md:flex hidden"
				>
					<Badge>Nice to meet you! 😁</Badge>
				</a>
			</h1>
			<p class="text-xl lg:text-2xl text-wrap max-w-[700px]">
				<span class="text-white font-semibold">DevOps </span>
				<Highlight class="font-semibold">Engineer</Highlight>
			</p>
			<p class="lg:text-xl text-white max-w-[700px] text-pretty mt-3">
				<span>
					<span>I'm a </span>
					<Highlight>CKA & ICA Certified</Highlight> 
					<span>DevOps/SRE/Platform Engineer with</span>
					<Highlight color="green">over 3 years of hands-on experience</Highlight>
					<span>in Kubernetes, Docker, and AWS cloud services. I specialize in</span>
					<Highlight>Istio, K8s Operators, optimizing workflows,</Highlight>
					<span>and implementing</span>
					<Highlight>cost-saving strategies</Highlight>

			</span>
			</p>

			<nav class="flex gap-4 mt-8 flex-wrap">
				<SocialPill href=`https://www.linkedin.com/in/dhruvchavda2712/`>
					<LinkedIn class="size-4 lg:size-6" />
					LinkedIn
				</SocialPill>

				<SocialPill href="https://github.com/DhruvChavda">
					<GitHub class="size-4 lg:size-6" />
					GitHub
				</SocialPill>

				<SocialPill href="https://medium.com/@chavdadhruv0505">
					<Medium class="size-4 lg:size-6" />
					Medium
				</SocialPill>
				
				<SocialPill href="https://www.credly.com/users/dhruvchavda">
					<Credly class="size-4 lg:size-6" />
					Credly	
				</SocialPill>			<SocialPill href="https://topmate.io/dhruvchavda/">
				<Topmate class="size-4 lg:size-6" />
				Topmate
			</SocialPill>				<SocialPill href="#">
					<Mail class="size-4 lg:size-6" />
					chavdadhruv0505@gmail.com
				</SocialPill>
			</nav>
		</SectionContainer>
		<SectionContainer id="about">
			<h2 class="group text-2xl font-semibold mb-6 flex gap-x-3 items-center hover:opacity-80 transition-opacity cursor-pointer">
				<a href="#about" class="group flex gap-x-3 items-center w-full">
					<Learn class="size-10" />
					<span class="group-hover:underline">About me 🤷🏻‍♂️</span>
				</a>
			</h2>
			<About />
		</SectionContainer>
		<SectionContainer id="skills">
			<h2 class="group text-2xl font-semibold mb-6 flex gap-x-3 items-center hover:opacity-80 transition-opacity cursor-pointer">
				<a href="#skills" class="group flex gap-x-3 items-center w-full">
					<Code class="size-10" />
					<span class="group-hover:underline">Skills 🧑🏻‍💻</span>
				</a>
			</h2>
			<Skills />
		</SectionContainer>
		<SectionContainer id="experience">
			<h2 class="group text-2xl font-semibold mb-6 flex gap-x-3 items-center hover:opacity-80 transition-opacity cursor-pointer">
				<a href="#experience" class="group flex gap-x-3 items-center w-full">
					<Briefcase class="size-10" />
					<span class="group-hover:underline">Experience 🚀</span>
				</a>
			</h2>
			<Experience />
		</SectionContainer>
		<SectionContainer id="Socials">
			<h2 class="group text-2xl font-semibold mb-6 flex gap-x-3 items-center hover:opacity-80 transition-opacity cursor-pointer">
				<a href="#socials" class="group flex gap-x-3 items-center w-full">
					<Team class="size-10" />
					<span class="group-hover:underline">Stay in Touch 👋🏻</span>
				</a>
			</h2>
			<Socials />
		</SectionContainer>
		<!-- <SectionContainer id="projects">
			<h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center">
				<Code class="size-7" />
				Projects
			</h2>
			<Projects />
		</SectionContainer> -->
	</main>
</Layout>