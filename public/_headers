/*
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/pictures/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/index.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff

/rss.xml
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/sitemap.xml
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
